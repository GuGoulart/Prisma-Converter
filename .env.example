# ─────────────────────────────────────────────────────────────────────────────
# Prisma Converter — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o arquivo .env real no repositório.
# ─────────────────────────────────────────────────────────────────────────────

# ── Obrigatórias ─────────────────────────────────────────────────────────────

# Chave secreta do Flask (sessions, CSRF).
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_REAL_AQUI

# ── Opcionais — Fase 3: Escala Horizontal ────────────────────────────────────

# Redis URL para:
#   - Rate limiting distribuído (Flask-Limiter com backend Redis)
#   - Fila de tarefas assíncronas (Celery)
# Sem esta variável: modo in-memory (funcional para 1 instância)
# Formato: redis://:senha@host:porta/db
# REDIS_URL=redis://localhost:6379/0

# Google Cloud Storage bucket para uploads/downloads persistentes.
# Requer papel "Storage Object Admin" na Service Account do Cloud Run.
# Sem esta variável: armazenamento local em disco (efêmero no Cloud Run).
# GCS_BUCKET=nome-do-seu-bucket-gcs
# GCS_PREFIX=prisma/

# ── Opcionais — Performance ──────────────────────────────────────────────────

# Número máximo de conversões rodando em paralelo no mesmo processo.
# Padrão: 4. Aumente apenas se tiver RAM suficiente (LibreOffice usa ~500MB cada).
# MAX_PARALELAS=4

# ── Desenvolvimento ───────────────────────────────────────────────────────────

# Ativar modo debug do Flask (NUNCA usar em produção!)
# FLASK_DEBUG=1
