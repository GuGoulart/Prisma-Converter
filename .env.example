# Variáveis opcionais do Prisma Converter. Nenhuma é necessária para o uso normal.
# Para usar, copie este arquivo para .env.

# Porta do servidor local. Se estiver ocupada por outro programa, o Prisma escolhe outra.
# PORT=5000

# Não abrir a janela automaticamente ao iniciar.
# NO_BROWSER=1

# Não encerrar o servidor quando a última janela for fechada.
# NO_AUTO_SHUTDOWN=1

# Pasta para uploads, downloads e configurações (padrão: a pasta do projeto).
# PRISMA_DATA_DIR=C:\caminho\para\os\dados

# Por padrão, a chave da sessão é gerada na primeira execução e salva em instance/secret_key.
# SECRET_KEY=
